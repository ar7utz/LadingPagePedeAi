            <div class="flex gap-6">
                <a href="#" class="hover:text-white">Termos</a>
                <a href="#" class="hover:text-white">Privacidade</a>
                <a href="#" class="hover:text-white">Contato</a>
            </div>
        </div>
    </footer>

</div>

@code {
    // Categorias do Hero
    private string CategoriaSelecionada = "Hamburgueria";
    private List<CategoriaItem> CategoriasHero = new()
    {
        new("Hamburgueria", "🍔"),
        new("Doceria", "🍰"),
        new("Pizzaria", "🍕"),
        new("Japonesa", "🍣")
    };

    // Simulador de Pedido
    private string CodigoPedidoSimulado = "9821";
    private bool SimulaçãoEnviada = false;
    private int StatusEtapa = 1;

    private List<ItemSimulador> ItensSimulador = new()
    {
        new("X-Salada Especial", 26.90m, 1),
        new("Coca-Cola Gelada 350ml", 7.00m, 1),
        new("Batata Frita Rústica", 14.00m, 0)
    };

    private decimal TotalCarrinho => ItensSimulador.Sum(i => i.Preco * i.Quantidade);

    private void AdicionarItem(ItemSimulador item) => item.Quantidade++;
    private void RemoverItem(ItemSimulador item)
    {
        if (item.Quantidade > 0) item.Quantidade--;
    }

    private void FinalizarPedidoSimulado()
    {
        if (TotalCarrinho > 0)
        {
            SimulaçãoEnviada = true;
            StatusEtapa = 1;
        }
    }

    private void AvançarStatusSimulado()
    {
        if (StatusEtapa < 3) StatusEtapa++;
    }

    // Calculadora de Economia
    private decimal FaturamentoMensal = 25000;
    private decimal CustoAppTradicional => FaturamentoMensal * 0.15m;
    private decimal EconomiaAnual => (CustoAppTradicional - 89.90m) * 12;

    // Toggle de Planos
    private bool PlanoAnual = true;

    // FAQ Accordion Logic
    private int? FaqAbertoId = 1;
    private void ToggleFaq(int id)
    {
        FaqAbertoId = FaqAbertoId == id ? null : id;
    }

    // Models Internos
    private record CategoriaItem(string Nome, string Icone);

    private class ItemSimulador
    {
        public string Nome { get; set; }
        public decimal Preco { get; set; }
        public int Quantidade { get; set; }

        public ItemSimulador(string nome, decimal preco, int quantidade)
        {
            Nome = nome;
            Preco = preco;
            Quantidade = quantidade;
        }
    }

    private class FaqItem
    {
        public int Id { get; set; }
        public string Pergunta { get; set; } = string.Empty;
        public string Resposta { get; set; } = string.Empty;
    }

    private List<FaqItem> ListaFaq = new()
    {
        new FaqItem { Id = 1, Pergunta = "Preciso pagar comissão por cada pedido?", Resposta = "Não! No Pede Aí você paga apenas uma mensalidade fixa e nada mais. 100% do valor da venda é seu." },
        new FaqItem { Id = 2, Pergunta = "O cliente precisa baixar algum aplicativo?", Resposta = "Não! O seu cliente acessa pelo navegador do celular através do seu link ou QR Code, escolhe os produtos e faz a conta de forma ultra rápida." },
        new FaqItem { Id = 3, Pergunta = "Como o pedido chega no meu WhatsApp?", Resposta = "Quando o cliente clica em 'Finalizar Pedido', a mensagem é formatada automaticamente e enviada direto para o WhatsApp do seu estabelecimento com todos os detalhes e endereço." },
        new FaqItem { Id = 4, Pergunta = "Como funciona o acompanhamento do pedido?", Resposta = "O cliente pode acessar o site do seu estabelecimento, criar uma conta e ver a atualização em tempo real se o pedido está sendo preparado, saiu para entrega ou se está pronto para retirada." }
